<Project Sdk="Microsoft.NET.Sdk">

  <!-- The desktop host (ADR-014, ADR-015): the app in a native webview, no listening socket. -->

  <PropertyGroup>
    <!-- WinExe: no console window on Windows. Elsewhere it is an ordinary executable. -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>Yass.Desktop</AssemblyName>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <!-- Precompiled when published for a runtime, so the window comes up without waiting on the JIT. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- The .exe's own icon on Windows; elsewhere the package carries it (scripts/package-desktop.sh). -->
    <ApplicationIcon>../../assets/logo/yass.ico</ApplicationIcon>
    <!-- LibraryImport (DesktopLog's message box) generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Yass.App/Yass.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Photino.NET" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window's own icon on Windows, which only loads one from an .ico. -->
    <None Include="../../assets/logo/yass.ico" Link="yass.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Yass.Desktop.Tests" />
  </ItemGroup>

</Project>
