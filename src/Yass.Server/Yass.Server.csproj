<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- Only trim assemblies that opt in; NAPS2, YamlDotNet and MessagePack rely on reflection. -->
    <TrimMode>partial</TrimMode>
    <!-- Our own assemblies are not trimmed (partial mode), so IL20xx analysis is noise. -->
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <!-- Partial trimming keeps every non-opted-in assembly whole; the linker still reports their IL2xxx warnings. -->
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <!-- PublishTrimmed turns this off; session.json uses reflection-based System.Text.Json. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Yass.App/Yass.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Yass.Server.Tests" />
  </ItemGroup>

</Project>
