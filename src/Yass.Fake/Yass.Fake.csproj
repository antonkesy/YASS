<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../Yass.Core/Yass.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <!--
    The pages the fake scanner feeds are rendered from the Markdown beside them rather than
    committed as images, so what they say and what they look like cannot drift apart. They go
    to obj/ and are embedded from there; nothing about them is checked in but the words.

    Paths are worked out inside the target because IntermediateOutputPath is not set yet where
    a csproj's own PropertyGroup is evaluated, and the render is left to decide what is stale:
    MSBuild's Inputs attribute takes a wildcard literally, and the script has to walk the
    documents anyway.
  -->
  <Target Name="RenderFixtures" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <FixtureSourceDir>$(MSBuildThisFileDirectory)Fixtures</FixtureSourceDir>
      <FixtureOutputDir>$(MSBuildThisFileDirectory)$(IntermediateOutputPath)fixtures</FixtureOutputDir>
    </PropertyGroup>

    <Exec Command="&quot;$(MSBuildThisFileDirectory)../../scripts/render-fixtures.sh&quot; &quot;$(FixtureSourceDir)&quot; &quot;$(FixtureOutputDir)&quot;" />

    <!--
      Two passes: inside a target, %(Filename) on an item being created batches over nothing
      and comes out empty. Update sees the items the Include just made.
    -->
    <ItemGroup>
      <EmbeddedResource Include="$(FixtureOutputDir)/*.png" />
      <EmbeddedResource Update="$(FixtureOutputDir)/*.png">
        <LogicalName>%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>
